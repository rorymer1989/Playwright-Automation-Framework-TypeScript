# Copy to `.env` (git-ignored). Values here are loaded first and never override
# variables already exported in the shell / CI.

# Target environment: dev | uat | pre-prod | prod
# Selects config/environments/<TEST_ENV>.env (BASE_URL lives there).
TEST_ENV=uat

# Optional execution overrides
# BROWSER=chromium
# PW_WORKERS=4

# Email report distribution (reporting/email). Gmail requires an App Password.
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
