# Copy to `.env` (git-ignored). Values here are loaded first and never override
# variables already exported in the shell / CI.

# Target environment: dev | uat | pre-prod | prod
# Selects config/environments/<TEST_ENV>.env (BASE_URL lives there).
TEST_ENV=uat

# Optional execution overrides
# BROWSER=chromium
# PW_WORKERS=4

# Email report distribution (reporting/email).
# Gmail requires an App Password (16 letters): https://myaccount.google.com/apppasswords — see README "Send Execution Email".
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=

# Framework log verbosity: silent | error | warn | info | debug
# LOG_LEVEL=info

# Email: Gmail blocks zipped HTML reports (they contain .js). Link the hosted report instead.
# REPORT_URL=https://github.com/<owner>/<repo>/actions
# EMAIL_ATTACH_REPORTS=auto|true|false   (default: attach unless EMAIL_SERVICE=gmail)
# EMAIL_MAX_ATTACHMENT_MB=18
