{
  "name": "playwright_automation-ts",
  "version": "1.12.0",
  "description": "Playwright Automation Framework (TypeScript)",
  "scripts": {
    "test": "sh scripts/clean-snap-env.sh playwright test",
    "test:headed": "sh scripts/clean-snap-env.sh playwright test --headed",
    "test:ui": "sh scripts/clean-snap-env.sh playwright test --ui",
    "test:chromium": "sh scripts/clean-snap-env.sh playwright test --project=chromium",
    "report": "playwright show-report",
    "allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "test:dev": "TEST_ENV=dev sh scripts/clean-snap-env.sh playwright test",
    "test:uat": "TEST_ENV=uat sh scripts/clean-snap-env.sh playwright test",
    "test:prod": "TEST_ENV=prod sh scripts/clean-snap-env.sh playwright test",
    "test:firefox": "sh scripts/clean-snap-env.sh playwright test --project=firefox",
    "test:webkit": "sh scripts/clean-snap-env.sh playwright test --project=webkit",
    "report:email": "tsx scripts/send-report.ts",
    "report:zip": "tsx scripts/zip-reports.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:api": "sh scripts/clean-snap-env.sh playwright test --project=api",
    "test:unit": "playwright test --project=unit",
    "test:a11y": "sh scripts/clean-snap-env.sh playwright test tests/a11y",
    "test:visual": "sh scripts/visual-docker.sh",
    "test:visual:update": "sh scripts/visual-docker.sh --update-snapshots",
    "test:visual:local": "sh scripts/clean-snap-env.sh playwright test tests/visual",
    "data:excel": "tsx scripts/generate-excel-data.ts",
    "test:demo-failures": "DEMO_FAILURES=1 sh scripts/clean-snap-env.sh playwright test tests/demo --project=chromium --retries=1",
    "jira:story": "tsx scripts/jira-story.ts",
    "test:story": "sh scripts/clean-snap-env.sh playwright test --grep",
    "jira:bugs": "tsx scripts/jira-bugs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
