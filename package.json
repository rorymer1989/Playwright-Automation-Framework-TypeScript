{
  "name": "playwright_automation-ts",
  "version": "1.2.0",
  "description": "Playwright Automation Framework (TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "test:dev": "TEST_ENV=dev playwright test",
    "test:uat": "TEST_ENV=uat playwright test",
    "test:prod": "TEST_ENV=prod playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "nodemailer": "^9.0.5",
    "xlsx": "^0.18.5"
  }
}
